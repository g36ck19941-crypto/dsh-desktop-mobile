{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面端（Electron 套壳本地 dsh web）",
  "main": "main.js",
  "author": "DSH",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Workbench",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "shell.html",
      "assets/**"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH 工作台",
      "artifactName": "DSH-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}.${ext}"
    }
  }
}